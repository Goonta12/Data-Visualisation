{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Where design's value comes from",
    "subtitle": [
      "Each square is 1% of value added.",
      "Design industries add $61.1 billion a year.",
      "Designers elsewhere add $6.4 billion a year."
    ]
  },
  "data": {
    "url": "data/design_value_added_ip_australia.csv",
    "format": {
      "parse": {
        "value_added_millions_2019_dollars": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "datum.industry == 'Fashion' ? 2 : datum.industry == 'Furniture' ? 3 : datum.industry == 'Visual arts and crafts' ? 4 : 1",
      "as": "order"
    },
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "value_added_millions_2019_dollars",
          "as": "total"
        }
      ],
      "groupby": [
        "group"
      ]
    },
    {
      "window": [
        {
          "op": "sum",
          "field": "value_added_millions_2019_dollars",
          "as": "cum"
        }
      ],
      "sort": [
        {
          "field": "order"
        }
      ],
      "groupby": [
        "group"
      ],
      "frame": [
        null,
        0
      ]
    },
    {
      "calculate": "sequence(round((datum.cum - datum.value_added_millions_2019_dollars) / datum.total * 100), round(datum.cum / datum.total * 100))",
      "as": "cells"
    },
    {
      "flatten": [
        "cells"
      ]
    },
    {
      "calculate": "floor(datum.cells / 10)",
      "as": "row"
    },
    {
      "calculate": "datum.cells % 10",
      "as": "col"
    },
    {
      "calculate": "datum.group == 'Design industries' ? 'Design industries' : 'Designers in other industries'",
      "as": "panel"
    }
  ],
  "facet": {
    "column": {
      "field": "panel",
      "type": "nominal",
      "title": null,
      "sort": [
        "Design industries"
      ],
      "header": {
        "labelFontSize": 14,
        "labelFontWeight": 500
      }
    }
  },
  "spec": {
    "width": 220,
    "height": 220,
    "mark": {
      "type": "square",
      "size": 330,
      "opacity": 1
    },
    "encoding": {
      "x": {
        "field": "col",
        "type": "ordinal",
        "axis": null
      },
      "y": {
        "field": "row",
        "type": "ordinal",
        "axis": null,
        "sort": "descending"
      },
      "color": {
        "field": "industry",
        "type": "nominal",
        "title": null,
        "sort": [
          "Design services, architecture, software and interactive content",
          "Fashion",
          "Furniture",
          "Visual arts and crafts"
        ],
        "scale": {
          "domain": [
            "Design services, architecture, software and interactive content",
            "Fashion",
            "Furniture",
            "Visual arts and crafts"
          ],
          "range": [
            "#1f78b4",
            "#e7298a",
            "#a6761d",
            "#7570b3"
          ]
        },
        "legend": {
          "orient": "bottom",
          "columns": 1,
          "labelLimit": 420,
          "symbolType": "square",
          "symbolSize": 150
        }
      },
      "tooltip": [
        {
          "field": "group",
          "title": "Group"
        },
        {
          "field": "industry",
          "title": "Industry"
        },
        {
          "field": "value_added_millions_2019_dollars",
          "title": "Value added ($m)",
          "format": ","
        }
      ]
    }
  },
  "config": {
    "view": {
      "stroke": null
    },
    "title": {
      "font": "Playfair Display, Georgia, serif",
      "fontSize": 20,
      "fontWeight": 700,
      "anchor": "start",
      "subtitleFontSize": 13,
      "subtitleColor": "#555",
      "subtitlePadding": 4,
      "offset": 10
    }
  }
}