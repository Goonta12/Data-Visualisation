{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Creative arts training peaks around Sydney and Melbourne",
    "subtitle": [
      "Creative arts share of qualified residents, 2016.",
      "Hexagons group local areas, about 80 km wide.",
      "Grey: fewer than 2,000 qualified residents."
    ]
  },
  "width": "container",
  "height": 500,
  "projection": {
    "type": "conicEqualArea",
    "rotate": [
      -132,
      0
    ],
    "center": [
      0,
      -27
    ],
    "parallels": [
      -18,
      -36
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/australia_states.geojson",
        "format": {
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#f6f4ee",
        "stroke": "#cfcbbf",
        "strokeWidth": 0.6
      }
    },
    {
      "data": {
        "url": "data/creative_arts_hexbins_2016.geojson",
        "format": {
          "property": "features"
        }
      },
      "transform": [
        {
          "calculate": "datum.properties.total >= 2000 ? datum.properties.creative_share : null",
          "as": "share"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "white",
        "strokeWidth": 0.8
      },
      "encoding": {
        "color": {
          "field": "share",
          "type": "quantitative",
          "title": "Creative arts share",
          "scale": {
            "scheme": "oranges",
            "domain": [
              0.015,
              0.065
            ]
          },
          "legend": {
            "orient": "bottom-left",
            "format": ".0%",
            "gradientLength": 200,
            "direction": "horizontal",
            "titleLimit": 300
          }
        },
        "tooltip": [
          {
            "field": "properties.total",
            "title": "Residents with a qualification",
            "format": ","
          },
          {
            "field": "properties.creative_arts",
            "title": "Creative arts",
            "format": ","
          },
          {
            "field": "properties.architecture_building",
            "title": "Architecture and building",
            "format": ","
          },
          {
            "field": "properties.lgas",
            "title": "Local government areas in hexagon"
          },
          {
            "field": "share",
            "title": "Creative arts share",
            "format": ".1%"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/creative_arts_hexbins_2016.geojson",
        "format": {
          "property": "features"
        }
      },
      "transform": [
        {
          "calculate": "datum.properties.total >= 2000 ? datum.properties.creative_share : null",
          "as": "share"
        },
        {
          "joinaggregate": [
            {
              "op": "max",
              "field": "share",
              "as": "mx"
            }
          ]
        },
        {
          "filter": "datum.share == datum.mx"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": null,
        "filled": false,
        "stroke": "#16294a",
        "strokeWidth": 2.5
      }
    },
    {
      "data": {
        "values": [
          {
            "city": "Sydney",
            "lon": 151.21,
            "lat": -33.87
          },
          {
            "city": "Melbourne",
            "lon": 144.96,
            "lat": -37.81
          },
          {
            "city": "Brisbane",
            "lon": 153.03,
            "lat": -27.47
          },
          {
            "city": "Perth",
            "lon": 115.86,
            "lat": -31.95
          },
          {
            "city": "Adelaide",
            "lon": 138.6,
            "lat": -34.93
          },
          {
            "city": "Canberra",
            "lon": 149.13,
            "lat": -35.28
          },
          {
            "city": "Hobart",
            "lon": 147.33,
            "lat": -42.88
          },
          {
            "city": "Darwin",
            "lon": 130.84,
            "lat": -12.46
          }
        ]
      },
      "layer": [
        {
          "mark": {
            "type": "circle",
            "size": 22,
            "color": "#222"
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "left",
            "dx": 6,
            "dy": -4,
            "fontSize": 11,
            "fontWeight": "bold",
            "color": "#222"
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "text": {
              "field": "city"
            }
          }
        }
      ]
    },
    {
      "data": {
        "url": "data/creative_arts_hexbins_2016.geojson",
        "format": {
          "property": "features"
        }
      },
      "transform": [
        {
          "calculate": "datum.properties.total >= 2000 ? datum.properties.creative_share : null",
          "as": "share"
        },
        {
          "calculate": "datum.properties.creative_arts",
          "as": "c"
        },
        {
          "calculate": "datum.properties.total",
          "as": "n"
        },
        {
          "aggregate": [
            {
              "op": "sum",
              "field": "c",
              "as": "C"
            },
            {
              "op": "sum",
              "field": "n",
              "as": "N"
            },
            {
              "op": "max",
              "field": "share",
              "as": "mx"
            }
          ]
        },
        {
          "calculate": "['Australia: ' + format(datum.C/datum.N,'.1%') + ' of qualified residents', 'Outlined hexagon: highest share, ' + format(datum.mx,'.1%')]",
          "as": "t"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "fontSize": 11,
        "fontStyle": "italic",
        "fontWeight": "bold",
        "color": "#16294a"
      },
      "encoding": {
        "x": {
          "value": 0
        },
        "y": {
          "value": 0
        },
        "text": {
          "field": "t"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": 133.5,
            "lat": -40.2,
            "t": [
              "Over half of creative arts graduates",
              "live around Sydney and Melbourne"
            ]
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontStyle": "italic",
        "color": "#16294a"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "t"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": 139,
            "lat": -38.9,
            "lon2": 144.6,
            "lat2": -37.9
          }
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#16294a",
        "strokeWidth": 1,
        "strokeDash": [
          3,
          2
        ]
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "longitude2": {
          "field": "lon2"
        },
        "latitude2": {
          "field": "lat2"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "title": {
      "font": "Playfair Display, Georgia, serif",
      "fontSize": 20,
      "fontWeight": 700,
      "anchor": "start",
      "subtitleFontSize": 13,
      "subtitleColor": "#555",
      "subtitlePadding": 4,
      "offset": 10
    }
  }
}