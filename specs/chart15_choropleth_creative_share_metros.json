{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Creative arts graduates favour the inner city",
    "subtitle": [
      "Creative arts share of qualified residents, 2016. One colour scale for all three maps.",
      "Close-ups of Sydney and Melbourne on the right; + marks each city centre.",
      "Outlined: the area with the highest share (areas with 2,000+ qualified residents)."
    ]
  },
  "hconcat": [
    {
      "title": {
        "text": "Australia",
        "fontSize": 13,
        "anchor": "start"
      },
      "width": 240,
      "height": 310,
      "projection": {
        "type": "conicEqualArea",
        "rotate": [
          -132,
          0
        ],
        "center": [
          0,
          -27
        ],
        "parallels": [
          -18,
          -36
        ],
        "scale": 355,
        "translate": [
          120,
          135
        ]
      },
      "data": {
        "url": "data/lga_boundaries_2016.geojson",
        "format": {
          "property": "features"
        }
      },
      "transform": [
        {
          "lookup": "properties.code",
          "from": {
            "data": {
              "url": "data/lga_design_qualifications_2016.csv"
            },
            "key": "code",
            "fields": [
              "creative_arts",
              "total",
              "architecture_building"
            ]
          }
        },
        {
          "calculate": "toNumber(datum.creative_arts) / toNumber(datum.total)",
          "as": "share"
        },
        {
          "calculate": "toNumber(datum.creative_arts)",
          "as": "c"
        },
        {
          "calculate": "toNumber(datum.total)",
          "as": "n"
        }
      ],
      "layer": [
        {
          "mark": {
            "type": "geoshape",
            "stroke": "white",
            "strokeWidth": 0.4,
            "clip": true
          },
          "encoding": {
            "color": {
              "field": "share",
              "type": "quantitative",
              "title": "Creative arts share of qualified residents",
              "scale": {
                "scheme": "oranges",
                "domain": [
                  0,
                  0.11
                ],
                "clamp": true
              },
              "legend": {
                "format": ".0%",
                "orient": "bottom",
                "direction": "horizontal",
                "gradientLength": 260,
                "title": "Creative arts share of qualified residents",
                "titleLimit": 300
              }
            },
            "tooltip": [
              {
                "field": "properties.name",
                "title": "Local government area"
              },
              {
                "field": "creative_arts",
                "title": "Creative arts",
                "format": ","
              },
              {
                "field": "architecture_building",
                "title": "Architecture and building",
                "format": ","
              },
              {
                "field": "total",
                "title": "Residents with a qualification",
                "format": ","
              },
              {
                "field": "share",
                "title": "Creative arts share",
                "format": ".1%"
              }
            ]
          }
        },
        {
          "transform": [
            {
              "filter": "isValid(datum.share) && datum.n >= 2000"
            },
            {
              "joinaggregate": [
                {
                  "op": "max",
                  "field": "share",
                  "as": "mx"
                }
              ]
            },
            {
              "filter": "datum.share == datum.mx"
            }
          ],
          "mark": {
            "type": "geoshape",
            "filled": false,
            "fill": null,
            "stroke": "#16294a",
            "strokeWidth": 2,
            "clip": true
          }
        },
        {
          "transform": [
            {
              "filter": "isValid(datum.share) && datum.n >= 2000"
            },
            {
              "joinaggregate": [
                {
                  "op": "max",
                  "field": "share",
                  "as": "mx"
                }
              ]
            },
            {
              "filter": "datum.share == datum.mx"
            },
            {
              "calculate": "'Highest: ' + datum.properties.name + ', ' + format(datum.share,'.1%')",
              "as": "t"
            }
          ],
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "top",
            "fontSize": 10,
            "fontStyle": "italic",
            "color": "#16294a",
            "fontWeight": "bold"
          },
          "encoding": {
            "x": {
              "value": 0
            },
            "y": {
              "value": 276
            },
            "text": {
              "field": "t"
            }
          }
        },
        {
          "transform": [
            {
              "filter": "isValid(datum.c) && isValid(datum.n)"
            },
            {
              "aggregate": [
                {
                  "op": "sum",
                  "field": "c",
                  "as": "C"
                },
                {
                  "op": "sum",
                  "field": "n",
                  "as": "N"
                }
              ]
            },
            {
              "calculate": "'Australia overall: ' + format(datum.C/datum.N,'.1%')",
              "as": "t"
            }
          ],
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "top",
            "fontSize": 10,
            "fontStyle": "italic",
            "color": "#16294a"
          },
          "encoding": {
            "x": {
              "value": 0
            },
            "y": {
              "value": 291
            },
            "text": {
              "field": "t"
            }
          }
        }
      ]
    },
