{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "SA gained architects; Tasmania and NT lost advertisers",
    "subtitle": [
      "Change in businesses, June 2007 to June 2012. Each tile is one state.",
      "Outlined: biggest gain and biggest fall. A third industry is left out (definition changed)."
    ]
  },
  "data": {
    "url": "data/design_businesses_by_state_long.csv",
    "format": {
      "parse": {
        "year": "number",
        "businesses": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.industry != 'Other design services'"
    },
    {
      "pivot": "year",
      "value": "businesses",
      "groupby": [
        "state",
        "industry"
      ]
    },
    {
      "calculate": "(datum['2012'] - datum['2007']) / datum['2007']",
      "as": "change"
    },
    {
      "calculate": "(datum.change > 0 ? '+' : '') + format(datum.change * 100, '.0f') + '%'",
      "as": "label"
    },
    {
      "lookup": "state",
      "from": {
        "data": {
          "url": "data/state_tiles.csv"
        },
        "key": "state",
        "fields": [
          "col",
          "row"
        ]
      }
    }
  ],
  "facet": {
    "column": {
      "field": "industry",
      "type": "nominal",
      "title": null,
      "sort": [
        "Architectural services",
        "Advertising services"
      ],
      "header": {
        "labelFontSize": 14,
        "labelFontWeight": 500
      }
    }
  },
  "spec": {
    "width": 270,
    "height": 300,
    "encoding": {
      "x": {
        "field": "col",
        "type": "ordinal",
        "axis": null
      },
      "y": {
        "field": "row",
        "type": "ordinal",
        "axis": null
      }
    },
    "layer": [
      {
        "mark": {
          "type": "rect",
          "stroke": "white",
          "strokeWidth": 4,
          "cornerRadius": 6
        },
        "encoding": {
          "color": {
            "field": "change",
            "type": "quantitative",
            "title": "Change since 2007",
            "scale": {
              "domain": [
                -0.4,
                0,
                0.4
              ],
              "range": [
                "#d95f02",
                "#f2f2f2",
                "#1f78b4"
              ],
              "clamp": true
            },
            "legend": {
              "orient": "bottom",
              "direction": "horizontal",
              "gradientLength": 300,
              "format": "+.0%",
              "offset": 34
            }
          },
          "tooltip": [
            {
              "field": "state",
              "title": "State"
            },
            {
              "field": "industry",
              "title": "Industry"
            },
            {
              "field": "2007",
              "title": "Businesses, 2007",
              "format": ","
            },
            {
              "field": "2012",
              "title": "Businesses, 2012",
              "format": ","
            },
            {
              "field": "label",
              "title": "Change"
            }
          ]
        }
      },
      {
        "transform": [
          {
            "joinaggregate": [
              {
                "op": "max",
                "field": "change",
                "as": "mx"
              },
              {
                "op": "min",
                "field": "change",
                "as": "mn"
              }
            ],
            "groupby": [
              "industry"
            ]
          },
          {
            "filter": "datum.change == datum.mx || datum.change == datum.mn"
          }
        ],
        "mark": {
          "type": "rect",
          "fill": null,
          "filled": false,
          "stroke": "#16294a",
          "strokeWidth": 3,
          "cornerRadius": 6
        }
      },
      {
        "mark": {
          "type": "text",
          "fontSize": 15,
          "fontWeight": "bold",
          "dy": -9
        },
        "encoding": {
          "text": {
            "field": "state"
          },
          "color": {
            "condition": {
              "test": "abs(datum.change) > 0.2",
              "value": "white"
            },
            "value": "#222"
          }
        }
      },
      {
        "mark": {
          "type": "text",
          "fontSize": 13,
          "dy": 9
        },
        "encoding": {
          "text": {
            "field": "label"
          },
          "color": {
            "condition": {
              "test": "abs(datum.change) > 0.2",
              "value": "white"
            },
            "value": "#222"
          }
        }
      },
      {
        "transform": [
          {
            "joinaggregate": [
              {
                "op": "max",
                "field": "change",
                "as": "mx"
              },
              {
                "op": "min",
                "field": "change",
                "as": "mn"
              }
            ],
            "groupby": [
              "industry"
            ]
          },
          {
            "filter": "datum.change == datum.mx || datum.change == datum.mn"
          },
          {
            "calculate": "datum.change == datum.mx ? 'biggest gain' : 'biggest fall'",
            "as": "tag"
          }
        ],
        "mark": {
          "type": "text",
          "fontSize": 9,
          "fontStyle": "italic",
          "dy": 24
        },
        "encoding": {
          "text": {
            "field": "tag"
          },
          "color": {
            "condition": {
              "test": "abs(datum.change) > 0.2",
              "value": "white"
            },
            "value": "#222"
          }
        }
      },
      {
        "transform": [
          {
            "aggregate": [
              {
                "op": "sum",
                "field": "2007",
                "as": "a"
              },
              {
                "op": "sum",
                "field": "2012",
                "as": "b"
              }
            ],
            "groupby": [
              "industry"
            ]
          },
          {
            "calculate": "'Australia overall: ' + (datum.b >= datum.a ? '+' : '') + format((datum.b-datum.a)/datum.a,'.0%') + ' (' + format(datum.a,',') + ' to ' + format(datum.b,',') + ' businesses)'",
            "as": "t"
          }
        ],
        "mark": {
          "type": "text",
          "align": "left",
          "baseline": "top",
          "fontSize": 11,
          "fontStyle": "italic",
          "fontWeight": "bold",
          "color": "#16294a"
        },
        "encoding": {
          "x": {
            "value": 0
          },
          "y": {
            "value": 310
          },
          "text": {
            "field": "t"
          }
        }
      }
    ]
  },
  "config": {
    "view": {
      "stroke": null
    },
    "title": {
      "font": "Playfair Display, Georgia, serif",
      "fontSize": 20,
      "fontWeight": 700,
      "anchor": "start",
      "subtitleFontSize": 13,
      "subtitleColor": "#555",
      "subtitlePadding": 4,
      "offset": 10
    }
  }
}