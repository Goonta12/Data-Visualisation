{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Women gained in graphics, lost in architecture",
    "subtitle": [
      "Women's share of each design activity.",
      "Dashed line: equal numbers of men and women."
    ]
  },
  "width": 400,
  "height": 380,
  "data": {
    "url": "data/participation_by_sex_all.csv",
    "format": {
      "parse": {
        "year": "number",
        "men": "number",
        "women": "number",
        "persons": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.year == 2001 || datum.year == 2007"
    },
    {
      "calculate": "datum.women / (datum.men + datum.women)",
      "as": "share"
    },
    {
      "joinaggregate": [
        {
          "op": "min",
          "field": "year",
          "as": "y0"
        }
      ],
      "groupby": [
        "activity"
      ]
    },
    {
      "calculate": "datum.year == 2001 ? datum.share : null",
      "as": "s01"
    },
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "s01",
          "as": "share2001"
        }
      ],
      "groupby": [
        "activity"
      ]
    },
    {
      "calculate": "datum.activity + '  ' + format(datum.share2001 * 100, '.0f') + '% to ' + format(datum.share * 100, '.0f') + '%'",
      "as": "label"
    }
  ],
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "title": null,
      "scale": {
        "padding": 0.5
      },
      "axis": {
        "labelFontSize": 14,
        "labelAngle": 0,
        "orient": "top",
        "ticks": false,
        "domain": false,
        "grid": false
      }
    },
    "y": {
      "field": "share",
      "type": "quantitative",
      "title": "Women's share of participants",
      "scale": {
        "domain": [
          0.2,
          0.9
        ]
      },
      "axis": {
        "format": "%",
        "tickCount": 7
      }
    },
    "color": {
      "field": "activity",
      "type": "nominal",
      "legend": null,
      "scale": {
        "domain": [
          "Fashion design",
          "Advertising",
          "Other design",
          "Graphic design",
          "Architecture"
        ],
        "range": [
          "#e7298a",
          "#d95f02",
          "#7570b3",
          "#1b9e77",
          "#1f78b4"
        ]
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "color": "#999",
        "strokeDash": [
          4,
          4
        ]
      },
      "encoding": {
        "x": null,
        "y": {
          "datum": 0.5
        }
      }
    },
    {
      "mark": {
        "type": "line",
        "strokeWidth": 3
      },
      "encoding": {
        "detail": {
          "field": "activity"
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 90,
        "opacity": 1
      },
      "encoding": {
        "tooltip": [
          {
            "field": "activity",
            "title": "Activity"
          },
          {
            "field": "year",
            "title": "Year"
          },
          {
            "field": "share",
            "title": "Women's share",
            "format": ".1%"
          },
          {
            "field": "women",
            "title": "Women",
            "format": ","
          },
          {
            "field": "men",
            "title": "Men",
            "format": ","
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year == 2007"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 12,
        "fontSize": 12,
        "fontWeight": 500
      },
      "encoding": {
        "text": {
          "field": "label"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "grid": true,
      "gridColor": "#eee"
    },
    "title": {
      "font": "Playfair Display, Georgia, serif",
      "fontSize": 20,
      "fontWeight": 700,
      "anchor": "start",
      "subtitleFontSize": 13,
      "subtitleColor": "#555",
      "subtitlePadding": 4,
      "offset": 10
    }
  }
}