{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Where the design firms are",
    "subtitle": [
      "Design businesses by state. Bigger circle = more firms.",
      "Colour = largest industry. Drag the slider to change the year."
    ]
  },
  "params": [
    {
      "name": "yi",
      "value": 2,
      "bind": {
        "input": "range",
        "min": 0,
        "max": 2,
        "step": 1,
        "name": "Drag to change the year  "
      }
    }
  ],
  "width": "container",
  "height": 380,
  "projection": {
    "type": "conicEqualArea",
    "rotate": [
      -132,
      0
    ],
    "center": [
      0,
      -27
    ],
    "parallels": [
      -18,
      -36
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/australia_states.geojson",
        "format": {
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e9e7e2",
        "stroke": "white",
        "strokeWidth": 1.5
      }
    },
    {
      "data": {
        "url": "data/design_businesses_by_state_years.csv"
      },
      "transform": [
        {
          "filter": "datum.year == [2001,2007,2012][yi]"
        },
        {
          "lookup": "state",
          "from": {
            "data": {
              "url": "data/state_labels.csv"
            },
            "key": "state",
            "fields": [
              "lon",
              "lat",
              "labelLat"
            ]
          }
        },
        {
          "calculate": "toNumber(datum.architecture)",
          "as": "arch"
        },
        {
          "calculate": "toNumber(datum.advertising)",
          "as": "adv"
        },
        {
          "calculate": "toNumber(datum.other_design)",
          "as": "oth"
        },
        {
          "calculate": "datum.arch + datum.adv + datum.oth",
          "as": "total"
        },
        {
          "joinaggregate": [
            {
              "op": "sum",
              "field": "total",
              "as": "national"
            }
          ]
        },
        {
          "calculate": "datum.total / datum.national",
          "as": "share"
        },
        {
          "calculate": "datum.arch >= datum.adv && datum.arch >= datum.oth ? 'Architecture' : (datum.adv >= datum.oth ? 'Advertising' : 'Other design')",
          "as": "largest"
        },
        {
          "calculate": "datum.state + ' ' + format(datum.total, ',') + ' (' + format(datum.share, '.0%') + ')'",
          "as": "label"
        },
        {
          "calculate": "toNumber(datum.labelLat)",
          "as": "labelLat"
        },
        {
          "calculate": "toNumber(datum.lon)",
          "as": "lon"
        },
        {
          "calculate": "toNumber(datum.lat)",
          "as": "lat"
        }
      ],
      "layer": [
        {
          "mark": {
            "type": "circle",
            "opacity": 0.8,
            "stroke": "white",
            "strokeWidth": 1.5
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "size": {
              "field": "total",
              "type": "quantitative",
              "title": "Design businesses",
              "scale": {
                "domain": [
                  0,
                  15000
                ],
                "range": [
                  0,
                  2800
                ]
              },
              "legend": {
                "orient": "bottom",
                "direction": "horizontal",
                "values": [
                  1000,
                  5000,
                  10000
                ],
                "format": ",.0f",
                "symbolOpacity": 0.5,
                "offset": 12
              }
            },
            "color": {
              "field": "largest",
              "type": "nominal",
              "title": null,
              "scale": {
                "domain": [
                  "Architecture",
                  "Advertising",
                  "Other design"
                ],
                "range": [
                  "#1f78b4",
                  "#d95f02",
                  "#7570b3"
                ]
              },
              "legend": {
                "orient": "top",
                "direction": "horizontal",
                "symbolSize": 80,
                "columnPadding": 12,
                "offset": 6
              }
            },
            "tooltip": [
              {
                "field": "year",
                "title": "Year"
              },
              {
                "field": "state",
                "title": "State"
              },
              {
                "field": "arch",
                "title": "Architecture",
                "format": ","
              },
              {
                "field": "adv",
                "title": "Advertising",
                "format": ","
              },
              {
                "field": "oth",
                "title": "Other design",
                "format": ","
              },
              {
                "field": "other_design_industry",
                "title": "'Other design' means"
              },
              {
                "field": "total",
                "title": "Total",
                "format": ","
              },
              {
                "field": "share",
                "title": "Share of all firms",
                "format": ".1%"
              }
            ]
          }
        },
        {
          "mark": {
            "type": "text",
            "fontSize": 11,
            "fontWeight": "bold",
            "color": "#1a1a1a"
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "labelLat",
              "type": "quantitative"
            },
            "text": {
              "field": "label"
            }
          }
        },
        {
          "transform": [
            {
              "aggregate": [
                {
                  "op": "sum",
                  "field": "total",
                  "as": "all"
                },
                {
                  "op": "max",
                  "field": "year",
                  "as": "y"
                }
              ]
            },
            {
              "calculate": "113.2",
              "as": "lon"
            },
            {
              "calculate": "-11.2",
              "as": "lat"
            }
          ],
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "bottom",
            "fontSize": 26,
            "fontWeight": "bold",
            "font": "Playfair Display, Georgia, serif",
            "color": "#16294a"
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "text": {
              "field": "y"
            }
          }
        },
        {
          "transform": [
            {
              "aggregate": [
                {
                  "op": "sum",
                  "field": "total",
                  "as": "all"
                }
              ]
            },
            {
              "calculate": "format(datum.all, ',') + ' design firms'",
              "as": "t"
            },
            {
              "calculate": "113.2",
              "as": "lon"
            },
            {
              "calculate": "-12.6",
              "as": "lat"
            }
          ],
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "top",
            "fontSize": 12,
            "fontWeight": "bold",
            "color": "#16294a"
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "text": {
              "field": "t"
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.state == 'NSW' || datum.state == 'VIC'"
            },
            {
              "aggregate": [
                {
                  "op": "sum",
                  "field": "share",
                  "as": "sv"
                }
              ]
            },
            {
              "calculate": "['NSW + Victoria:', format(datum.sv, '.0%') + ' of all firms']",
              "as": "t"
            },
            {
              "calculate": "131",
              "as": "lon"
            },
            {
              "calculate": "-37.3",
              "as": "lat"
            }
          ],
          "mark": {
            "type": "text",
            "fontSize": 11,
            "fontStyle": "italic",
            "color": "#16294a"
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "text": {
              "field": "t"
            }
          }
        },
        {
          "transform": [
            {
              "aggregate": [
                {
                  "op": "max",
                  "field": "year",
                  "as": "y"
                }
              ]
            },
            {
              "calculate": "datum.y == 2001 ? ['Older counting method:','compare patterns, not exact numbers'] : (datum.y == 2007 ? ['Other design = commercial','art and display services'] : ['Other design = other','specialised design services'])",
              "as": "t"
            },
            {
              "calculate": "131",
              "as": "lon"
            },
            {
              "calculate": "-39.4",
              "as": "lat"
            }
          ],
          "mark": {
            "type": "text",
            "align": "center",
            "baseline": "top",
            "fontSize": 10,
            "fontStyle": "italic",
            "color": "#666"
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "text": {
              "field": "t"
            }
          }
        }
      ]
    },
    {
      "data": {
        "values": [
          {
            "lon": 136.5,
            "lat": -36.4,
            "lon2": 145.8,
            "lat2": -35.0
          }
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#16294a",
        "strokeWidth": 1.2,
        "strokeDash": [
          3,
          2
        ]
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "longitude2": {
          "field": "lon2"
        },
        "latitude2": {
          "field": "lat2"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "legend": {
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titleLimit": 400
    },
    "title": {
      "font": "Playfair Display, Georgia, serif",
      "fontSize": 20,
      "fontWeight": 700,
      "anchor": "start",
      "subtitleFontSize": 13,
      "subtitleColor": "#555",
      "subtitlePadding": 4,
      "offset": 10
    }
  }
}