{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Where the design firms are",
    "subtitle": [
      "Design businesses by state, June 2012.",
      "Bigger circle = more firms. Colour = largest industry."
    ]
  },
  "width": "container",
  "height": 380,
  "projection": {
    "type": "conicEqualArea",
    "rotate": [
      -132,
      0
    ],
    "center": [
      0,
      -27
    ],
    "parallels": [
      -18,
      -36
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/australia_states.geojson",
        "format": {
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e9e7e2",
        "stroke": "white",
        "strokeWidth": 1.5
      }
    },
    {
      "data": {
        "url": "data/state_labels.csv"
      },
      "transform": [
        {
          "lookup": "state",
          "from": {
            "data": {
              "url": "data/design_businesses_by_state_2012.csv"
            },
            "key": "state",
            "fields": [
              "Architectural services",
              "Advertising services",
              "Other specialised design services"
            ]
          },
          "as": [
            "arch",
            "adv",
            "oth"
          ]
        },
        {
          "calculate": "toNumber(datum.arch) + toNumber(datum.adv) + toNumber(datum.oth)",
          "as": "total"
        },
        {
          "joinaggregate": [
            {
              "op": "sum",
              "field": "total",
              "as": "national"
            }
          ]
        },
        {
          "calculate": "datum.total / datum.national",
          "as": "share"
        },
        {
          "calculate": "toNumber(datum.arch) >= toNumber(datum.adv) && toNumber(datum.arch) >= toNumber(datum.oth) ? 'Architectural services' : (toNumber(datum.adv) >= toNumber(datum.oth) ? 'Advertising services' : 'Other specialised design services')",
          "as": "largest"
        },
        {
          "calculate": "datum.state + ' ' + format(datum.total, ',') + ' (' + format(datum.share, '.0%') + ')'",
          "as": "label"
        }
      ],
      "layer": [
        {
          "mark": {
            "type": "circle",
            "opacity": 0.8,
            "stroke": "white",
            "strokeWidth": 1.5
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "size": {
              "field": "total",
              "type": "quantitative",
              "title": "Design businesses",
              "scale": {
                "range": [
                  0,
                  2800
                ]
              },
              "legend": {
                "orient": "bottom",
                "direction": "horizontal",
                "values": [
                  1000,
                  5000,
                  10000
                ],
                "format": ",.0f",
                "symbolOpacity": 0.5,
                "labelFontSize": 10,
                "titleFontSize": 10,
                "offset": 12
              }
            },
            "color": {
              "field": "largest",
              "type": "nominal",
              "title": "Largest industry",
              "scale": {
                "domain": [
                  "Architectural services",
                  "Advertising services",
                  "Other specialised design services"
                ],
                "range": [
                  "#1f78b4",
                  "#d95f02",
                  "#7570b3"
                ]
              },
              "legend": {
                "orient": "top",
                "direction": "horizontal",
                "title": null,
                "labelExpr": "datum.label == 'Architectural services' ? 'Architecture' : datum.label == 'Advertising services' ? 'Advertising' : 'Other design'",
                "labelFontSize": 10,
                "symbolSize": 80,
                "offset": 6,
                "columnPadding": 12
              }
            },
            "tooltip": [
              {
                "field": "state",
                "title": "State"
              },
              {
                "field": "arch",
                "title": "Architecture",
                "format": ","
              },
              {
                "field": "adv",
                "title": "Advertising",
                "format": ","
              },
              {
                "field": "oth",
                "title": "Other specialised design",
                "format": ","
              },
              {
                "field": "total",
                "title": "Total",
                "format": ","
              },
              {
                "field": "share",
                "title": "Share of all firms",
                "format": ".1%"
              }
            ]
          }
        },
        {
          "mark": {
            "type": "text",
            "fontSize": 11,
            "fontWeight": "bold",
            "color": "#1a1a1a"
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "labelLat",
              "type": "quantitative"
            },
            "text": {
              "field": "label"
            }
          }
        },
        {
          "transform": [
            {
              "aggregate": [
                {
                  "op": "sum",
                  "field": "total",
                  "as": "all"
                }
              ]
            },
            {
              "calculate": "['Australia:', format(datum.all, ',') + ' design firms']",
              "as": "note"
            },
            {
              "calculate": "113.5",
              "as": "lon"
            },
            {
              "calculate": "-13",
              "as": "lat"
            }
          ],
          "mark": {
            "type": "text",
            "align": "left",
            "fontSize": 12,
            "fontWeight": "bold",
            "color": "#16294a"
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "text": {
              "field": "note"
            }
          }
        }
      ]
    },
    {
      "data": {
        "values": [
          {
            "lon": 136.5,
            "lat": -36.4,
            "lon2": 145.8,
            "lat2": -35.0
          }
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#16294a",
        "strokeWidth": 1.2,
        "strokeDash": [
          3,
          2
        ]
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "longitude2": {
          "field": "lon2"
        },
        "latitude2": {
          "field": "lat2"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": 131,
            "lat": -37.3,
            "note": [
              "NSW + Victoria:",
              "two thirds of all firms"
            ]
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontStyle": "italic",
        "color": "#16294a"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "note"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "legend": {
      "labelFontSize": 11,
      "titleFontSize": 11
    },
    "title": {
      "font": "Playfair Display, Georgia, serif",
      "fontSize": 20,
      "fontWeight": 700,
      "anchor": "start",
      "subtitleFontSize": 13,
      "subtitleColor": "#555",
      "subtitlePadding": 4,
      "offset": 10
    }
  }
}