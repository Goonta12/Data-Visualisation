{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Design skills cluster around the capital cities",
    "subtitle": [
      "Census 2016: each dot is about 250 residents.",
      "Blue: architecture and building. Orange: creative arts.",
      "Dots are placed randomly inside each area."
    ]
  },
  "width": "container",
  "height": 500,
  "projection": {
    "type": "conicEqualArea",
    "rotate": [
      -132,
      0
    ],
    "center": [
      0,
      -27
    ],
    "parallels": [
      -18,
      -36
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/lga_boundaries_2016.geojson",
        "format": {
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#f1efe9",
        "stroke": "#d9d6cc",
        "strokeWidth": 0.4
      }
    },
    {
      "data": {
        "url": "data/design_qualification_dots_2016.csv"
      },
      "mark": {
        "type": "circle",
        "size": 9,
        "opacity": 0.75
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "color": {
          "field": "type",
          "type": "nominal",
          "title": "1 dot = about 250 people",
          "scale": {
            "domain": [
              "Architecture and building",
              "Creative arts"
            ],
            "range": [
              "#1f78b4",
              "#d95f02"
            ]
          },
          "legend": {
            "orient": "bottom-left",
            "symbolSize": 120,
            "symbolOpacity": 1,
            "labelExpr": "datum.label == 'Creative arts' ? 'Creative arts (401,161 people)' : 'Architecture and building (633,308 people)'",
            "labelLimit": 340,
            "titleLimit": 300
          }
        },
        "tooltip": [
          {
            "field": "type",
            "title": "Qualification field"
          },
          {
            "field": "lga_code",
            "title": "LGA code"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "city": "Sydney",
            "lon": 151.21,
            "lat": -33.87
          },
          {
            "city": "Melbourne",
            "lon": 144.96,
            "lat": -37.81
          },
          {
            "city": "Brisbane",
            "lon": 153.03,
            "lat": -27.47
          },
          {
            "city": "Perth",
            "lon": 115.86,
            "lat": -31.95
          },
          {
            "city": "Adelaide",
            "lon": 138.6,
            "lat": -34.93
          },
          {
            "city": "Canberra",
            "lon": 149.13,
            "lat": -35.28
          },
          {
            "city": "Hobart",
            "lon": 147.33,
            "lat": -42.88
          },
          {
            "city": "Darwin",
            "lon": 130.84,
            "lat": -12.46
          }
        ]
      },
      "layer": [
        {
          "mark": {
            "type": "circle",
            "size": 26,
            "color": "#222",
            "stroke": "white",
            "strokeWidth": 1
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "left",
            "dx": 6,
            "dy": -5,
            "fontSize": 11,
            "fontWeight": "bold",
            "color": "#222",
            "stroke": "white",
            "strokeWidth": 3,
            "strokeOpacity": 0.8
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "text": {
              "field": "city"
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "left",
            "dx": 6,
            "dy": -5,
            "fontSize": 11,
            "fontWeight": "bold",
            "color": "#222"
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "text": {
              "field": "city"
            }
          }
        }
      ]
    },
    {
      "data": {
        "values": [
          {
            "lon": 134,
            "lat": -24.5,
            "t": [
              "Inland Australia is almost empty:",
              "few qualified residents live here"
            ]
          },
          {
            "lon": 133.5,
            "lat": -40.2,
            "t": [
              "Dots crowd the south-east coast,",
              "from Brisbane to Melbourne"
            ]
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontStyle": "italic",
        "color": "#16294a"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "t"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": 139,
            "lat": -38.9,
            "lon2": 149.5,
            "lat2": -35.4
          }
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#16294a",
        "strokeWidth": 1,
        "strokeDash": [
          3,
          2
        ]
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "longitude2": {
          "field": "lon2"
        },
        "latitude2": {
          "field": "lat2"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "title": {
      "font": "Playfair Display, Georgia, serif",
      "fontSize": 20,
      "fontWeight": 700,
      "anchor": "start",
      "subtitleFontSize": 13,
      "subtitleColor": "#555",
      "subtitlePadding": 4,
      "offset": 10
    }
  }
}