{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Architects working alone",
    "subtitle": [
      "Share of architects working on their own account, with no",
      "employees, by Census year. Drag the slider to change the year."
    ]
  },
  "params": [
    {
      "name": "yi",
      "value": 2,
      "bind": {
        "input": "range",
        "min": 0,
        "max": 2,
        "step": 1,
        "name": "Drag to change the year  "
      }
    }
  ],
  "width": "container",
  "height": 380,
  "projection": {
    "type": "conicEqualArea",
    "rotate": [
      -132,
      0
    ],
    "center": [
      0,
      -27
    ],
    "parallels": [
      -18,
      -36
    ]
  },
  "data": {
    "url": "data/architects_employment_by_state_2001_2011.csv"
  },
  "transform": [
    {
      "filter": "datum.year == [2001,2006,2011][yi]"
    },
    {
      "lookup": "abbr",
      "from": {
        "data": {
          "url": "data/australia_states.geojson",
          "format": {
            "property": "features"
          }
        },
        "key": "properties.state",
        "fields": [
          "geometry",
          "properties"
        ]
      }
    },
    {
      "calculate": "toNumber(datum.employees)",
      "as": "e"
    },
    {
      "calculate": "toNumber(datum.own_account)",
      "as": "o"
    },
    {
      "calculate": "toNumber(datum.employers)",
      "as": "m"
    },
    {
      "calculate": "datum.e + datum.o + datum.m",
      "as": "total"
    },
    {
      "calculate": "datum.o / datum.total",
      "as": "alone"
    },
    {
      "calculate": "toNumber(datum.lon)",
      "as": "lon"
    },
    {
      "calculate": "toNumber(datum.lat)",
      "as": "lat"
    },
    {
      "calculate": "datum.abbr + ' ' + format(datum.alone, '.0%')",
      "as": "label"
    },
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "alone",
          "as": "mx"
        },
        {
          "op": "sum",
          "field": "o",
          "as": "O"
        },
        {
          "op": "sum",
          "field": "total",
          "as": "T"
        }
      ]
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "geoshape",
        "stroke": "white",
        "strokeWidth": 1.5
      },
      "encoding": {
        "shape": {
          "field": "geometry",
          "type": "geojson"
        },
        "color": {
          "field": "alone",
          "type": "quantitative",
          "title": "Share working alone",
          "scale": {
            "scheme": "blues",
            "domain": [
              0,
              0.45
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "format": ".0%",
            "values": [
              0,
              0.15,
              0.3,
              0.45
            ],
            "gradientLength": 160,
            "gradientThickness": 10,
            "offset": 12
          }
        },
        "tooltip": [
          {
            "field": "year",
            "title": "Census year"
          },
          {
            "field": "state",
            "title": "State"
          },
          {
            "field": "total",
            "title": "Architects (employment stated)",
            "format": ","
          },
          {
            "field": "o",
            "title": "Working alone",
            "format": ","
          },
          {
            "field": "m",
            "title": "Employing others",
            "format": ","
          },
          {
            "field": "e",
            "title": "Employees",
            "format": ","
          },
          {
            "field": "alone",
            "title": "Share working alone",
            "format": ".1%"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.alone == datum.mx"
        }
      ],
      "mark": {
        "type": "geoshape",
        "filled": false,
        "stroke": "#f2b134",
        "strokeWidth": 3
      },
      "encoding": {
        "shape": {
          "field": "geometry",
          "type": "geojson"
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": "bold"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        },
        "color": {
          "condition": {
            "test": "datum.alone > 0.27 && datum.abbr != 'ACT'",
            "value": "white"
          },
          "value": "#1a1a1a"
        }
      }
    },
    {
      "transform": [
        {
          "aggregate": [
            {
              "op": "max",
              "field": "year",
              "as": "y"
            }
          ]
        },
        {
          "calculate": "113.2",
          "as": "lon"
        },
        {
          "calculate": "-11.2",
          "as": "lat"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "bottom",
        "fontSize": 26,
        "fontWeight": "bold",
        "font": "Playfair Display, Georgia, serif",
        "color": "#16294a"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "y"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.alone == datum.mx"
        },
        {
          "calculate": "'Australia: ' + format(datum.O/datum.T,'.0%') + ' worked alone'",
          "as": "t"
        },
        {
          "calculate": "113.2",
          "as": "lon2"
        },
        {
          "calculate": "-11.7",
          "as": "lat2"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#16294a"
      },
      "encoding": {
        "longitude": {
          "field": "lon2",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat2",
          "type": "quantitative"
        },
        "text": {
          "field": "t"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.alone == datum.mx"
        },
        {
          "calculate": "datum.year == 2011 ? ['Highest: ' + datum.state + ', ' + format(datum.alone,'.0%'), 'The 2011 Census changed how', 'owner-managers were counted'] : (datum.year == 2006 ? ['Highest: ' + datum.state + ', ' + format(datum.alone,'.0%'), 'Fewer worked alone and more', 'employed staff than in 2001'] : ['Highest: ' + datum.state + ', ' + format(datum.alone,'.0%'), 'About 1 in 4 architects', 'worked alone in 2001'])",
          "as": "t"
        },
        {
          "calculate": "131",
          "as": "lon"
        },
        {
          "calculate": "-36.6",
          "as": "lat"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontStyle": "italic",
        "color": "#16294a"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "t"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "legend": {
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titleLimit": 400
    },
    "title": {
      "font": "Playfair Display, Georgia, serif",
      "fontSize": 20,
      "fontWeight": 700,
      "anchor": "start",
      "subtitleFontSize": 13,
      "subtitleColor": "#555",
      "subtitlePadding": 4,
      "offset": 10
    }
  }
}